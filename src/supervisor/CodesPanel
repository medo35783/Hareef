/**
 * supervisor/CodesPanel.jsx
 * ──────────────────────────
 * لوحة تحكم الأكواد — خاصة بـ Domain Admin
 * يعرض: إحصائيات + توليد أكواد + قائمة كل الأكواد
 */
import { useState, useEffect } from "react";
import { ref, push, set, onValue } from "firebase/database";

const PACKAGES = [
  { duration: 1, price: 15, label: "يوم",    hours: 24,  discount: 0  },
  { duration: 3, price: 35, label: "3 أيام", hours: 72,  discount: 22 },
  { duration: 7, price: 50, label: "أسبوع",  hours: 168, discount: 52 },
];

const CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
const genRandom = () => {
  let c = "CODE-";
  for (let i = 0; i < 6; i++) c += CHARS[Math.floor(Math.random() * CHARS.length)];
  return c;
};

export default function CodesPanel({ db, notify }) {
  const [codes,     setCodes    ] = useState({});
  const [loading,   setLoading  ] = useState(true);
  const [pkg,       setPkg      ] = useState(3);
  const [count,     setCount    ] = useState(1);
  const [generating,setGenerating] = useState(false);
  const [recent,    setRecent   ] = useState([]);

  /* ══ Firebase listener ══ */
  useEffect(() => {
    const r = ref(db, "codes");
    const unsub = onValue(r, (snap) => {
      setCodes(snap.exists() ? snap.val() : {});
      setLoading(false);
    });
    return () => unsub();
  }, [db]);

  /* ══ إحصائيات ══ */
  const vals   = Object.values(codes);
  const stats  = {
    total:   vals.length,
    unused:  vals.filter((c) => c.status === "unused").length,
    active:  vals.filter((c) => c.status === "active").length,
    expired: vals.filter((c) => c.status === "expired").length,
  };

  /* ══ توليد أكواد ══ */
  const handleGenerate = async () => {
    if (count < 1 || count > 100) { notify("بين 1 و 100 فقط", "error"); return; }
    setGenerating(true);
    const sel  = PACKAGES.find((p) => p.duration === pkg);
    const list = [];
    try {
      for (let i = 0; i < count; i++) {
        const r2   = push(ref(db, "codes"));
        const data = {
          code: genRandom(), duration: pkg, durationHours: sel.hours,
          price: sel.price, status: "unused",
          createdAt: Date.now(), activatedAt: null, expiresAt: null,
        };
        await set(r2, data);
        list.push(data);
      }
      setRecent(list);
      notify(`✅ تم توليد ${count} كود`, "success");
    } catch {
      notify("❌ خطأ في التوليد", "error");
    } finally {
      setGenerating(false);
    }
  };

  /* ══ نسخ الأكواد ══ */
  const copyAll = () => {
    navigator.clipboard.writeText(recent.map((c) => c.code).join("\n"));
    notify("📋 تم نسخ الأكواد", "gold");
  };

  /* ══ تصدير CSV ══ */
  const exportCSV = () => {
    const rows = [
      ["الكود", "المدة", "السعر", "الحالة", "تاريخ الإنشاء"].join(","),
      ...vals.map((c) => [
        c.code, `${c.duration} أيام`, `${c.price} ريال`,
        { unused: "جديد", active: "مفعّل", expired: "منتهي" }[c.status] || c.status,
        new Date(c.createdAt).toLocaleDateString("ar-SA"),
      ].join(",")),
    ].join("\n");
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob(["\ufeff" + rows], { type: "text/csv;charset=utf-8;" }));
    a.download = `codes_${Date.now()}.csv`;
    a.click();
  };

  if (loading) return (
    <div style={{ textAlign: "center", padding: 40 }}>
      <div style={{ fontSize: 40, marginBottom: 12 }}>⏳</div>
      <div>جاري التحميل...</div>
    </div>
  );

  return (
    <div className="scr">
      <div className="ptitle">👑 إدارة الأكواد</div>
      <div className="psub">توليد وإدارة أكواد الاشتراكات</div>

      {/* إحصائيات */}
      <div className="card">
        <div className="ctitle">📊 إحصائيات سريعة</div>
        <div className="sg sg4">
          {[
            { num: stats.total,   lbl: "الإجمالي",     clr: "var(--text)"  },
            { num: stats.unused,  lbl: "غير مستخدم",   clr: "var(--blue)"  },
            { num: stats.active,  lbl: "مُفعّل",        clr: "var(--green)" },
            { num: stats.expired, lbl: "منتهي",         clr: "var(--muted)" },
          ].map((s) => (
            <div key={s.lbl} className="sbox">
              <div className="snum" style={{ color: s.clr }}>{s.num}</div>
              <div className="slbl">{s.lbl}</div>
            </div>
          ))}
        </div>
      </div>

      {/* توليد */}
      <div className="card">
        <div className="ctitle">🎫 توليد أكواد جديدة</div>

        <div className="blbl">الباقة:</div>
        <div className="bgrid" style={{ marginBottom: 14 }}>
          {PACKAGES.map((p) => (
            <div
              key={p.duration}
              className={`nt ${pkg === p.duration ? "nsel" : ""}`}
              onClick={() => setPkg(p.duration)}
            >
              <div style={{ fontSize: 18 }}>{p.duration === 1 ? "🌟" : p.duration === 3 ? "⭐" : "💎"}</div>
              <div style={{ fontSize: 12, fontWeight: 700 }}>{p.label}</div>
              <div style={{ fontSize: 11, color: "var(--gold)" }}>{p.price} ريال</div>
            </div>
          ))}
        </div>

        <div className="ig">
          <label className="lbl">عدد الأكواد:</label>
          <input
            type="number" className="inp"
            value={count} min={1} max={100}
            onChange={(e) => setCount(Math.min(100, Math.max(1, +e.target.value || 1)))}
          />
        </div>

        <button className="btn bg" onClick={handleGenerate} disabled={generating}>
          {generating ? "⏳ جاري التوليد..." : "🎫 توليد"}
        </button>
      </div>

      {/* الأكواد المولّدة حديثاً */}
      {recent.length > 0 && (
        <div className="card">
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
            <div className="ctitle">✨ مولّدة حديثاً ({recent.length})</div>
            <button className="btn bv bsm" onClick={copyAll}>📋 نسخ</button>
          </div>
          <div style={{ maxHeight: 200, overflowY: "auto" }}>
            {recent.map((c, i) => (
              <div key={i} style={{
                padding: "8px 12px", background: "#09091e", borderRadius: 6,
                marginBottom: 4, display: "flex", justifyContent: "space-between",
                fontFamily: "'Cairo',sans-serif", fontWeight: 700, color: "var(--gold)", fontSize: 14,
              }}>
                <span>{c.code}</span>
                <span style={{ fontSize: 10, color: "var(--muted)" }}>{c.duration} يوم</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* كل الأكواد */}
      <div className="card">
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
          <div className="ctitle">📋 كل الأكواد ({stats.total})</div>
          <button className="btn bgh bsm" onClick={exportCSV}>📥 CSV</button>
        </div>
        <div style={{ maxHeight: 400, overflowY: "auto" }}>
          {Object.values(codes)
            .sort((a, b) => b.createdAt - a.createdAt)
            .map((c, i) => <CodeRow key={i} code={c} />)}
        </div>
      </div>
    </div>
  );
}

/* ── صف الكود ── */
function CodeRow({ code }) {
  const map = {
    unused:  { bg: "rgba(79,163,224,.08)",  border: "var(--blue)",  lbl: "🆕 جديد"   },
    active:  { bg: "rgba(46,204,113,.08)",  border: "var(--green)", lbl: "✅ مُفعّل"  },
    expired: { bg: "rgba(122,116,160,.08)", border: "var(--muted)", lbl: "⏰ منتهي"  },
  };
  const s = map[code.status] || map.unused;

  return (
    <div style={{
      background: s.bg, border: `1px solid ${s.border}`,
      borderRadius: 10, padding: "10px 12px", marginBottom: 7,
    }}>
      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 5 }}>
        <span style={{ fontFamily: "'Cairo',sans-serif", fontWeight: 900, color: "var(--gold)", fontSize: 14, letterSpacing: 1 }}>
          {code.code}
        </span>
        <span style={{ fontSize: 10, color: s.border, fontWeight: 700 }}>{s.lbl}</span>
      </div>
      <div style={{ display: "flex", gap: 12, fontSize: 11, color: "var(--muted)" }}>
        <span>⏰ {code.duration} {code.duration === 1 ? "يوم" : "أيام"}</span>
        <span>💰 {code.price} ريال</span>
        <span>📅 {new Date(code.createdAt).toLocaleDateString("ar-SA", { month: "short", day: "numeric" })}</span>
      </div>
    </div>
  );
}
